# Copy this file to .env and replace placeholder values with local credentials.
POSTGRES_DB=agent_platform
POSTGRES_USER=agent
POSTGRES_PASSWORD=replace-with-local-password
POSTGRES_PORT=5420

ASPNETCORE_URLS=http://+:8080
FRONTEND_API_PORT=8080
AGENT_API_PORT=8081
PLATFORM_CONNECTION_STRING=Host=postgres;Port=5432;Database=agent_platform;Username=agent;Password=replace-with-local-password
NATS_URL=nats://nats:4222
NATS_STREAM_NAME=AGENT_PLATFORM

# Pre-created external Docker network shared with MCP server containers.
MCP_NETWORK_NAME=agent-platform-mcp

ADMIN_PORT=3010
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# The issuer URL for the same Clerk instance, e.g. https://example.clerk.accounts.dev
CLERK_JWT_ISSUER=
# UUID of the regular agent exposed as Jim in the administration chat.
JIM_AGENT_ID=
