# Copy this file to .env and replace placeholder values with local credentials.
POSTGRES_DB=agent_platform
POSTGRES_USER=agent
POSTGRES_PASSWORD=replace-with-local-password
POSTGRES_PORT=5420

ASPNETCORE_URLS=http://+:8080
FRONTEND_API_PORT=8080
AGENT_API_PORT=8081
PLATFORM_CONNECTION_STRING=Host=postgres;Port=5432;Database=agent_platform;Username=agent;Password=replace-with-local-password
KNOWLEDGE_BASE_POSTGRES_DB=knowledge_base
KNOWLEDGE_BASE_CONNECTION_STRING=Host=postgres;Port=5432;Database=knowledge_base;Username=agent;Password=replace-with-local-password
# Shared only by the platform control plane and knowledge-base service for internal ownership checks.
KNOWLEDGE_BASE_SERVICE_KEY=ynsYSevD2tvrh9O7fuYNFQ9t84bQmMkP
NATS_URL=nats://nats:4222
NATS_STREAM_NAME=AGENT_PLATFORM

# Comma-separated outbound destination hostnames. Leave empty to deny that destination type.
# HTTP is allowed only for MCP hosts listed in both MCP values; all other destinations require HTTPS and public DNS answers.
OUTBOUND_HTTP__ALLOWED_LLM_HOSTS=
OUTBOUND_HTTP__ALLOWED_WEBHOOK_HOSTS=
OUTBOUND_HTTP__ALLOWED_MCP_HOSTS=api
OUTBOUND_HTTP__INTERNAL_MCP_HOSTS=api

# Pre-created external Docker network shared with MCP server containers.
MCP_NETWORK_NAME=agent-platform-mcp

ADMIN_PORT=3010
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# The issuer URL for the same Clerk instance, e.g. https://example.clerk.accounts.dev
CLERK_JWT_ISSUER=
# Comma-separated Clerk user IDs allowed to bootstrap into the administrator role.
# At least one value is required before publishing the administration UI.
ADMINISTRATION__BOOTSTRAP_ADMIN_CLERK_USER_IDS=
# UUID of the regular agent exposed as Jim in the administration chat.
JIM_AGENT_ID=
# Server-only Agent API key created for Jim. This must never use the NEXT_PUBLIC_ prefix.
JIM_AGENT_API_KEY=
